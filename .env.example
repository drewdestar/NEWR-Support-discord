# Copy to .env and fill in your own values. NEVER commit a real .env file.
# No token, secret, or password is stored in code or in this example.
DISCORD_TOKEN=
# Guild commands sync target. Example (NEWR LABS, from the verified
# server check): 1465422166790242377 -- this is only an example value
# for .env; the code itself reads GUILD_ID from the environment and
# does not hardcode it, and role mapping never hardcodes role IDs.
GUILD_ID=1465422166790242377
# Optional: channel for join logs, and ticket category (IDs from Discord).
LOG_CHANNEL_ID=
SUPPORT_CATEGORY_ID=
# Shared brain: ONE memory.db for BOTH bots. Leave the default
# (shared-brain/memory.db next to memory.py) or set the SAME path
# here for both bots. Never put a token/key in this file.
SHARED_BRAIN_DB=/home/hatch/workspace/bots/shared-brain/memory.db
